{
  "name": "angleyou-playwright",
  "version": "1.0.0",
  "description": "Playwright E2E automation framework for AngleYou",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test:visual": "playwright test tests/visual",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ci": "playwright test --reporter=github,html",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report reports/html",
    "codegen": "playwright codegen https://angleyou.com"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "ws": "^8.21.0"
  }
}
